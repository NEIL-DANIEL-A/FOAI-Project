{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "architect": {
      "mode": "primary",
      "description": "Lead architect and multi-agent orchestrator",
      "model": "opencode/nemotron-3-ultra-free"
    },

    "builder": {
      "mode": "subagent",
      "description": "Senior implementation and coding specialist",
      "model": "opencode/mimo-v2.5-free"
    },

    "researcher": {
      "mode": "subagent",
      "description": "Technical research and analysis specialist",
      "model": "opencode/deepseek-v4-flash-free"
    },

    "debugger": {
      "mode": "subagent",
      "description": "Debugging and testing specialist",
      "model": "opencode/nemotron-3.5-lightning-free"
    },

    "reviewer": {
      "mode": "subagent",
      "description": "Independent senior code reviewer",
      "model": "ollama-cloud/gpt-oss:120b"
    }
  },

  "default_agent": "architect",
}